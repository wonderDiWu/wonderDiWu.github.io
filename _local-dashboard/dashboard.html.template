<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Visitor Analytics · diwu.uk</title>
  <style>
    :root{--bg:#f4f7fb;--panel:#fff;--ink:#172033;--muted:#68758a;--line:#e5eaf1;--brand:#0b7189;--brand2:#52a7b8;--warn:#9a5b13;--shadow:0 8px 30px rgba(23,32,51,.06)}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.45 Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.shell{width:min(1500px,calc(100% - 40px));margin:0 auto;padding:30px 0 50px}
    header{display:flex;justify-content:space-between;gap:20px;align-items:center;margin-bottom:22px}.eyebrow{color:var(--brand);font-size:12px;font-weight:750;letter-spacing:.12em;text-transform:uppercase}h1{margin:3px 0 2px;font-size:30px;letter-spacing:-.035em}.subhead{color:var(--muted)}button{border:0;border-radius:9px;background:var(--brand);color:#fff;padding:10px 16px;font:inherit;font-weight:700;cursor:pointer;box-shadow:0 4px 12px rgba(11,113,137,.2)}button:hover{background:#075c70}button:disabled{opacity:.6;cursor:wait}.status{display:flex;gap:10px;align-items:center}.sync{font-size:12px;color:var(--muted);text-align:right}.warning{display:none;margin:0 0 18px;padding:11px 14px;border:1px solid #f0d09d;border-radius:9px;background:#fff8e8;color:var(--warn)}
    .cards{display:grid;grid-template-columns:repeat(8,minmax(120px,1fr));gap:12px;margin-bottom:18px}.card,.panel{background:var(--panel);border:1px solid var(--line);border-radius:13px;box-shadow:var(--shadow)}.card{padding:16px}.card-label{min-height:34px;color:var(--muted);font-size:12px;font-weight:650}.card-value{font-size:25px;font-weight:760;letter-spacing:-.03em}.card-value.small{font-size:15px;line-height:1.35;letter-spacing:0}
    .grid{display:grid;grid-template-columns:1.65fr 1fr;gap:16px;margin-bottom:16px}.panel{padding:18px;min-width:0}.panel h2{font-size:16px;margin:0}.panel-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}.hint{font-size:12px;color:var(--muted)}canvas{display:block;width:100%;height:240px}.split{display:grid;grid-template-columns:1fr 1fr;gap:16px}.rank{margin:0;padding:0;list-style:none}.rank li{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;padding:8px 0;border-bottom:1px solid var(--line)}.rank li:last-child{border:0}.rank-name{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.rank-value{color:var(--muted);font-variant-numeric:tabular-nums}.bar{height:4px;margin-top:5px;border-radius:3px;background:#edf2f5;overflow:hidden}.bar i{display:block;height:100%;background:var(--brand2)}
    .table-panel{padding:0;overflow:hidden}.table-head{padding:18px;display:flex;align-items:center;justify-content:space-between;gap:15px;border-bottom:1px solid var(--line)}.filters{display:flex;gap:8px;flex-wrap:wrap}input,select{max-width:220px;padding:8px 10px;border:1px solid #d8dee8;border-radius:8px;background:#fff;color:var(--ink);font:inherit}table{width:100%;border-collapse:collapse;table-layout:fixed}th{padding:10px 12px;background:#f8fafc;color:#657287;font-size:11px;letter-spacing:.04em;text-align:left;text-transform:uppercase}td{padding:10px 12px;border-top:1px solid var(--line);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:12px}tbody tr:hover{background:#f8fbfc}.table-wrap{overflow:auto}.empty{padding:42px;text-align:center;color:var(--muted)}.pagination{display:flex;justify-content:space-between;align-items:center;padding:12px 18px;border-top:1px solid var(--line);color:var(--muted)}.pagination button{padding:6px 10px;box-shadow:none}.pagination-controls{display:flex;gap:7px}
    @media(max-width:1150px){.cards{grid-template-columns:repeat(4,1fr)}}@media(max-width:800px){.shell{width:min(100% - 20px,1500px);padding-top:18px}.cards{grid-template-columns:repeat(2,1fr)}.grid,.split{grid-template-columns:1fr}header,.table-head{align-items:flex-start;flex-direction:column}.status{width:100%;justify-content:space-between}table{min-width:1100px}}
  </style>
</head>
<body>
<main class="shell">
  <header><div><div class="eyebrow">Private · Local only</div><h1>Visitor Analytics</h1><div class="subhead">diwu.uk · rolling 30-day Cloudflare KV data</div></div><div class="status"><div id="lastSync" class="sync">Last synced: —</div><button id="refresh">Refresh data</button></div></header>
  <div id="warning" class="warning"></div>
  <section id="cards" class="cards"></section>
  <section class="grid"><article class="panel"><div class="panel-head"><h2>Traffic over time</h2><span class="hint">Visits per day</span></div><canvas id="daily"></canvas></article><article class="panel"><div class="panel-head"><h2>Hour of day</h2><span class="hint">Your browser timezone</span></div><canvas id="hourly"></canvas></article></section>
  <section class="grid"><article class="panel"><div class="panel-head"><h2>Countries</h2><span class="hint">Top locations</span></div><div id="countries"></div></article><article class="panel"><div class="split"><div><div class="panel-head"><h2>Regions</h2></div><div id="regions"></div></div><div><div class="panel-head"><h2>Cities</h2></div><div id="cities"></div></div></div></article></section>
  <section class="grid"><article class="panel"><div class="split"><div><div class="panel-head"><h2>Popular pages</h2></div><div id="pages"></div></div><div><div class="panel-head"><h2>Referrers</h2></div><div id="referrers"></div></div></div></article><article class="panel"><div class="split"><div><div class="panel-head"><h2>Browsers</h2></div><div id="browsers"></div></div><div><div class="panel-head"><h2>Operating systems</h2></div><div id="systems"></div></div></div></article></section>
  <section class="panel table-panel"><div class="table-head"><div><h2>Recent visits</h2><span id="resultCount" class="hint"></span></div><div class="filters"><input id="search" type="search" placeholder="Search visits"><select id="countryFilter"><option value="">All countries</option></select><select id="pathFilter"><option value="">All pages</option></select></div></div><div id="tableWrap" class="table-wrap"></div><div class="pagination"><span id="pageInfo"></span><div class="pagination-controls"><button id="prev">Previous</button><button id="next">Next</button></div></div></section>
</main>
<script>
  const state={records:[],filtered:[],page:1,pageSize:50};
  const $=id=>document.getElementById(id);const safe=v=>String(v??"");
  const validDate=value=>{const date=new Date(value);return Number.isNaN(date.getTime())?null:date};
  const countBy=(items,getter)=>{const map=new Map;items.forEach(item=>{const key=getter(item)||"Unknown";map.set(key,(map.get(key)||0)+1)});return [...map].sort((a,b)=>b[1]-a[1]||a[0].localeCompare(b[0]))};
  function ua(record){const value=safe(record.userAgent);if(value.includes("/")){const [browser,os]=value.split("/",2);return {browser:browser||"Other",os:os||"Other"}}const browser=/Edg/i.test(value)?"Edge":/Firefox/i.test(value)?"Firefox":/Chrome/i.test(value)?"Chrome":/Safari/i.test(value)?"Safari":"Other";const os=/Android/i.test(value)?"Android":/iPhone|iPad|iOS/i.test(value)?"iOS":/Windows/i.test(value)?"Windows":/Mac/i.test(value)?"macOS":/Linux/i.test(value)?"Linux":"Other";return {browser,os}}
  function referrer(value){if(!value)return "Direct";try{const host=new URL(value).hostname.replace(/^www\./,"");if(/scholar\.google/.test(host))return "Google Scholar";if(/google\./.test(host))return "Google";if(/github\.com$/.test(host))return "GitHub";if(/linkedin\.com$/.test(host))return "LinkedIn";return host}catch{return safe(value)||"Direct"}}
  function countryName(code){if(!code)return "Unknown";try{return `${new Intl.DisplayNames([navigator.language],{type:"region"}).of(code)} (${code})`}catch{return code}}
  function rank(id,data,total=0,label=x=>x,limit=10){const top=data.slice(0,limit),max=top[0]?.[1]||1;$(id).innerHTML=top.length?`<ol class="rank">${top.map(([name,count])=>`<li><div class="rank-name" title="${escapeHtml(label(name))}">${escapeHtml(label(name))}<div class="bar"><i style="width:${count/max*100}%"></i></div></div><span class="rank-value">${count}${total?` · ${(count/total*100).toFixed(1)}%`:""}</span></li>`).join("")}</ol>`:`<div class="empty">No data</div>`}
  const escapeHtml=value=>safe(value).replace(/[&<>"']/g,char=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[char]));
  function drawChart(id,labels,values,type="bar"){const canvas=$(id),ratio=devicePixelRatio||1,width=canvas.clientWidth,height=canvas.clientHeight;canvas.width=width*ratio;canvas.height=height*ratio;const ctx=canvas.getContext("2d");ctx.scale(ratio,ratio);ctx.clearRect(0,0,width,height);const pad={l:34,r:8,t:12,b:34},w=width-pad.l-pad.r,h=height-pad.t-pad.b,max=Math.max(...values,1);ctx.strokeStyle="#e8edf3";ctx.fillStyle="#718096";ctx.font="10px system-ui";for(let i=0;i<=4;i++){const y=pad.t+h*i/4;ctx.beginPath();ctx.moveTo(pad.l,y);ctx.lineTo(width-pad.r,y);ctx.stroke();ctx.fillText(Math.round(max*(4-i)/4),3,y+3)}if(type==="line"){ctx.strokeStyle="#0b7189";ctx.lineWidth=2;ctx.beginPath();values.forEach((v,i)=>{const x=pad.l+(values.length===1?w/2:i*w/(values.length-1)),y=pad.t+h-v/max*h;i?ctx.lineTo(x,y):ctx.moveTo(x,y)});ctx.stroke()}else{const step=w/values.length;values.forEach((v,i)=>{ctx.fillStyle="#52a7b8";ctx.fillRect(pad.l+i*step+2,pad.t+h-v/max*h,Math.max(step-4,2),v/max*h)})}ctx.fillStyle="#718096";const every=Math.max(1,Math.ceil(labels.length/8));labels.forEach((label,i)=>{if(i%every)return;const x=pad.l+(type==="line"?(labels.length===1?w/2:i*w/(labels.length-1)):(i+.5)*w/labels.length);ctx.save();ctx.translate(x,height-12);ctx.textAlign="center";ctx.fillText(label,0,0);ctx.restore()})}
  function renderCards(records){const now=Date.now(),today=new Date();today.setHours(0,0,0,0);const dated=records.map(r=>({...r,_date:validDate(r.time)}));const cards=[["Total visits",records.length],["Visits today",dated.filter(r=>r._date>=today).length],["Last 24 hours",dated.filter(r=>r._date&&now-r._date<864e5).length],["Last 7 days",dated.filter(r=>r._date&&now-r._date<7*864e5).length],["Unique IPs",new Set(records.map(r=>r.ip).filter(Boolean)).size],["Unique IPs today",new Set(dated.filter(r=>r._date>=today).map(r=>r.ip).filter(Boolean)).size],["Countries",new Set(records.map(r=>r.country).filter(Boolean)).size],["Most recent",dated.find(r=>r._date)?dated.find(r=>r._date)._date.toLocaleString():"—"]];$("cards").innerHTML=cards.map(([label,value],i)=>`<article class="card"><div class="card-label">${label}</div><div class="card-value ${i===7?"small":""}">${escapeHtml(value)}</div></article>`).join("")}
  function renderCharts(records){const daily=new Map;for(let offset=29;offset>=0;offset--){const d=new Date;d.setHours(0,0,0,0);d.setDate(d.getDate()-offset);daily.set(d.toLocaleDateString("en-CA"),0)}records.forEach(r=>{const d=validDate(r.time);if(d){const key=d.toLocaleDateString("en-CA");if(daily.has(key))daily.set(key,daily.get(key)+1)}});drawChart("daily",[...daily.keys()].map(x=>x.slice(5)),[...daily.values()],"line");const hours=Array(24).fill(0);records.forEach(r=>{const d=validDate(r.time);if(d)hours[d.getHours()]++});drawChart("hourly",hours.map((_,i)=>String(i).padStart(2,"0")),hours)}
  function renderAggregates(records){rank("countries",countBy(records,r=>r.country),records.length, countryName);rank("regions",countBy(records,r=>r.region));rank("cities",countBy(records,r=>r.city));rank("pages",countBy(records,r=>r.path||"/"));rank("referrers",countBy(records,r=>referrer(r.referrer)));rank("browsers",countBy(records,r=>ua(r).browser));rank("systems",countBy(records,r=>ua(r).os))}
  function fillFilters(records){const currentCountry=$("countryFilter").value,currentPath=$("pathFilter").value;$("countryFilter").innerHTML='<option value="">All countries</option>'+countBy(records,r=>r.country).map(([v])=>`<option value="${escapeHtml(v)}">${escapeHtml(countryName(v))}</option>`).join("");$("pathFilter").innerHTML='<option value="">All pages</option>'+countBy(records,r=>r.path||"/").map(([v])=>`<option value="${escapeHtml(v)}">${escapeHtml(v)}</option>`).join("");$("countryFilter").value=currentCountry;$("pathFilter").value=currentPath}
  function applyFilters(){const query=$("search").value.toLowerCase(),country=$("countryFilter").value,path=$("pathFilter").value;state.filtered=state.records.filter(r=>(!country||r.country===country)&&(!path||(r.path||"/")===path)&&(!query||Object.values(r).some(v=>safe(v).toLowerCase().includes(query))));state.page=1;renderTable()}
  function renderTable(){const start=(state.page-1)*state.pageSize,rows=state.filtered.slice(start,start+state.pageSize),columns=["time","ip","country","region","city","path","referrer","browser","operating system"];$('resultCount').textContent=`${state.filtered.length} matching records`;$('pageInfo').textContent=`Page ${state.page} of ${Math.max(1,Math.ceil(state.filtered.length/state.pageSize))}`;$('prev').disabled=state.page===1;$('next').disabled=start+state.pageSize>=state.filtered.length;if(!rows.length){$('tableWrap').innerHTML='<div class="empty">No matching visits</div>';return}$('tableWrap').innerHTML=`<table><colgroup><col style="width:170px"><col style="width:145px"><col style="width:70px"><col style="width:120px"><col style="width:120px"><col style="width:155px"><col style="width:190px"><col style="width:90px"><col style="width:100px"></colgroup><thead><tr>${columns.map(x=>`<th>${x}</th>`).join("")}</tr></thead><tbody>${rows.map(r=>{const agent=ua(r),values=[validDate(r.time)?.toLocaleString()||r.time,r.ip,r.country,r.region,r.city,r.path||"/",referrer(r.referrer),agent.browser,agent.os];return `<tr>${values.map(v=>`<td title="${escapeHtml(v)}">${escapeHtml(v||"—")}</td>`).join("")}</tr>`}).join("")}</tbody></table>`}
  function render(payload){state.records=Array.isArray(payload.visitors)?payload.visitors:[];state.filtered=[...state.records];renderCards(state.records);renderCharts(state.records);renderAggregates(state.records);fillFilters(state.records);renderTable();$('lastSync').textContent=`Last synced: ${payload.lastSynced?new Date(payload.lastSynced).toLocaleString():"Never"}`;const messages=[];if(payload.warning)messages.push(payload.warning);if(payload.malformedLines)messages.push(`${payload.malformedLines} malformed log line(s) were skipped.`);$('warning').textContent=messages.join(" ");$('warning').style.display=messages.length?"block":"none"}
  async function load(){const response=await fetch('/api/visitors',{cache:'no-store'});render(await response.json())}
  $('refresh').addEventListener('click',async()=>{const button=$('refresh');button.disabled=true;button.textContent='Refreshing…';try{const response=await fetch('/api/refresh',{method:'POST',headers:{'X-Dashboard-Request':'refresh'}});const payload=await response.json();render(payload)}catch(error){$('warning').textContent=`Refresh failed: ${error}`;$('warning').style.display='block'}finally{button.disabled=false;button.textContent='Refresh data'}});['search','countryFilter','pathFilter'].forEach(id=>$(id).addEventListener(id==='search'?'input':'change',applyFilters));$('prev').onclick=()=>{if(state.page>1){state.page--;renderTable()}};$('next').onclick=()=>{if(state.page*state.pageSize<state.filtered.length){state.page++;renderTable()}};addEventListener('resize',()=>renderCharts(state.records));load();
</script>
</body>
</html>
